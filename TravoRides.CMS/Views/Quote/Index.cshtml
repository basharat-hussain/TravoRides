@using AlArwaSolutions.Application.Common.Responses
@using AlArwaSolutions.Application.DTOs.Common
@using AlArwaSolutions.Application.DTOs.Quote
@model ApiResponse<PagedResponse<QuoteDTO>>



<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quotes</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Quotes</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quotes</h3>
            
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_QuotesPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>
</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Quote";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var purpose = $btn.data('purpose') || '';
        var name = $btn.data('name') || '';
        var phone = $btn.data('phone') || '';
        var email = $btn.data('email') || '';
        var requirements = $btn.data('requirements') || '';

        var html = '<div class="row">';
        html += '<div class="col-md-4">';
        // if (image) {
        //     html += '<img src="' + image + '" class="img-fluid" />';
        // }
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Purpose:</strong> ' + $('<div/>').text(purpose).html() + '</p>';
        html += '<p><strong>Name:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Phone:</strong> ' + $('<div/>').text(phone).html() + '</p>';
        html += '<p><strong>Email:</strong> ' + $('<div/>').text(email).html() + '</p>';
        html += '<p><strong>Requirements:</strong><br />' + $('<div/>').text(requirements).html().replace(/\n/g, '<br/>') + '</p>';
        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Quote');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>
