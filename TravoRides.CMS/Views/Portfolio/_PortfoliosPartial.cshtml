@using AlArwaSolutions.Application.DTOs.Common
@using AlArwaSolutions.Application.DTOs.Portfolio
@model PagedResponse<PortfolioDTO>

@if (Model.Items.Count() > 0)
{
    <thead>
        <tr>
            <th style="width: 5%">
                S.No
            </th>

            <th style="width: 10%">
                Category
            </th>

            <th style="width: 10%">
                Title
            </th>

            <th style="width: 15%">
                Image
            </th>
            <th style="width: 10%">
                 ProjectUrl
            </th>
            <th style="width:10%">
                Technology
            </th>
            <th style="width: 20%" class="text-center">
                Description
            </th>
            <th style="width: 10%" class="text-center">
                Actions
            </th>
            <th style="width: 10%" class="text-center">
                View
        </tr>
    </thead>

    <tbody>
        @{ int count = 1;}
        @foreach (var portfolio in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@portfolio.Id" />

                </td>

                <td class="name">@portfolio.Category</td>

                <td>@portfolio.Title</td>

                <td><img src="@portfolio.ImageUrl" class="img-fluid" style="height:80px; width:200px;" /></td>

                <td>
                    @portfolio.ProjectUrl<br />
                    
                </td>
                 <td>
                    @portfolio.Technology<br />
                    
                </td>
               <td>
                    @{ var fb = portfolio.Description ?? string.Empty; }
                    @((fb.Length > 50) ? fb.Substring(0, 50) + "..." : fb)
                </td>

                <td class="project-actions text-center">

                    <a asp-controller="Portfolio" asp-action="Edit" asp-route-id="@portfolio.Id" class="btn btn-warning btn-sm" data-toggle="tooltip" data-placement="top" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a class="btn btn-danger btn-sm btn-delete" href="#" data-toggle="modal" data-target="#modal-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm btn-view" onclick="showReviewDetails(this)"
                            data-id="@portfolio.Id"
                            data-title="@portfolio.Title"
                            data-category="@portfolio.Category"
                            data-technology="@portfolio.Technology"
                            data-projecturl="@portfolio.ProjectUrl"
                            data-description="@portfolio.Description"
                             data-image="@portfolio.ImageUrl"
                           >
                        View
                    </button>
                    </td>
            </tr>
        }



    </tbody>
}
else
{
    <tr>
        <td>Sorry! No Clients found</td>
    </tr>}
