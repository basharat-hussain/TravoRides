@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Package
@using TravoRides.Application.DTOs.Common
@model ApiResponse<PagedResponse<PackageDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Packages</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Packages</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Packages</h3>

            <div class="card-tools">
                <a asp-controller="Package" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> &nbsp; Add Package
                </a>

            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_PackagesPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Package";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var name = $btn.data('name') || '';
        var price = $btn.data('price') || '';
        var discount = $btn.data('discount') || '';
        var inclusions = $btn.data('inclusions') || '';
        var distance = $btn.data('distance') || '';
        var duration = $btn.data('duration') || '';
        var places = $btn.data('places') || '';

        var route = $btn.data('route') || '';
        var description = $btn.data('description')|| '';

        var imageurl = $btn.data('imageurl') || '';

        var html = '<div class="row">';
        html += '<div class="col-md-4">';
        if (imageurl) {
            html += '<img src="' + imageurl + '" class="img-fluid" />';
        }
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Name:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Price:</strong> ' + $('<div/>').text(price).html() + '</p>';
        html += '<p><strong>Discount:</strong> ' + $('<div/>').text(discount).html() + '</p>';
        html += '<p><strong>Inclusions:</strong> ' + $('<div/>').text(inclusions).html() + '</p>';
        html += '<p><strong>Itenarary:</strong> ' + $('<div/>').text(itenarary).html() + '</p>';
        html += '<p><strong>Distance:</strong> ' + $('<div/>').text(distance).html() + '</p>';
        html += '<p><strong>Duration:</strong> ' + $('<div/>').text(duration).html() + '</p>';
        html += '<p><strong>Route:</strong> ' + $('<div/>').text(route).html() + '</p>';

        html += '<p><strong>Places:</strong> ' + $('<div/>').text(places).html() + '</p>';

        html += '<p><strong>Description:</strong><br />' + $('<div/>').text(description).html().replace(/\n/g, '<br/>') + '</p>';

        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Package');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>