@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.FeaturesMaster
@model PagedResponse<FeaturesMasterDTO>

@if (Model != null && Model.Items.Any())
{
    <thead>
        <tr>
            <th style="width: 8%">#</th>
            <th style="width: 8%" class="text-center">Icon</th>
            <th style="width: 28%">Feature Name</th>
            <th style="width: 36%">Description</th>
            <th style="width: 10%" class="text-center">Actions</th>
            <th style="width: 10%" class="text-center">Details</th>
        </tr>
    </thead>

    <tbody>
        @{ int count = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
        @foreach (var feature in Model.Items)
        {
            var iconClass = !string.IsNullOrWhiteSpace(feature.Icon) && feature.Icon.Contains("fa-")
                ? feature.Icon
                : "fas fa-star";

            <tr>
                <td>
                    <span class="font-weight-bold text-muted">@(count++)</span>
                    <input type="hidden" class="hdn-id" value="@feature.Id" />
                </td>

                <td class="text-center">
                    <span class="rounded d-inline-flex align-items-center justify-content-center border bg-light shadow-sm" style="width: 36px; height: 36px;">
                        <i class="@iconClass text-primary"></i>
                    </span>
                </td>

                <td>
                    <div class="name font-weight-bold text-dark">@feature.Title</div>
                    @if (!string.IsNullOrWhiteSpace(feature.Icon))
                    {
                        <small class="text-muted"><code>@feature.Icon</code></small>
                    }
                </td>

                <td>
                    @{ var fb = feature.Description ?? string.Empty; }
                    <span class="text-secondary" style="font-size: 0.875rem;">@((fb.Length > 70) ? fb.Substring(0, 70) + "..." : fb)</span>
                </td>

                <td class="text-center">
                    <div class="btn-group btn-group-sm">
                        <a asp-controller="FeatureMaster" asp-action="Edit" asp-route-id="@feature.Id" class="btn btn-warning" data-toggle="tooltip" data-placement="top" title="Edit Feature">
                            <i class="fas fa-pen"></i>
                        </a>
                        <button type="button" class="btn btn-danger btn-delete" data-toggle="modal" data-target="#modal-delete" title="Delete Feature">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-info btn-sm btn-view" onclick="showReviewDetails(this)"
                            data-id="@feature.Id"
                            data-title="@feature.Title"
                            data-icon="@feature.Icon"
                            data-description="@feature.Description">
                        <i class="fas fa-eye mr-1"></i> View
                    </button>
                </td>
            </tr>
        }
    </tbody>
}
else
{
    <tbody>
        <tr>
            <td colspan="6" class="text-center py-5">
                <i class="fas fa-star fa-3x text-muted mb-3 d-block"></i>
                <h5 class="font-weight-bold text-dark">No Features Found</h5>
                <p class="text-muted mb-3">No features are registered yet. Get started by adding master features.</p>
                <a asp-controller="FeatureMaster" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-1"></i> Add Feature
                </a>
            </td>
        </tr>
    </tbody>
}
