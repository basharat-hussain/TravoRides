@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Payment
@using TravoRides.Domain.Enums
@model PagedResponse<PaymentDTO>

@if (Model != null && Model.Items.Any())
{
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 13%">Payment #</th>
            <th style="width: 12%">Booking #</th>
            <th style="width: 18%">Customer</th>
            <th style="width: 11%">Amount</th>
            <th style="width: 10%">Status</th>
            <th style="width: 16%">Gateway / Trans ID</th>
            <th style="width: 10%">Date</th>
            <th style="width: 5%" class="text-center">Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = (Model.PageNumber - 1) * Model.PageSize + 1;
        }
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@p.Id" />
                </td>
                <td>
                    <strong class="text-primary font-weight-bold">@p.PaymentNumber</strong>
                    @if (p.AttemptNumber > 1)
                    {
                        <br /><span class="badge badge-secondary" style="font-size: 0.75rem;">Attempt #@p.AttemptNumber</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(p.BookingNo))
                    {
                        <span class="badge badge-light border font-weight-bold">@p.BookingNo</span>
                    }
                    else
                    {
                        <span class="text-muted">N/A</span>
                    }
                </td>
                <td>
                    <div><strong>@(p.CustomerName ?? "N/A")</strong></div>
                    @if (!string.IsNullOrWhiteSpace(p.CustomerPhone))
                    {
                        <div><small><i class="fas fa-phone mr-1"></i>@p.CustomerPhone</small></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.CustomerEmail))
                    {
                        <div><small><i class="fas fa-envelope mr-1"></i>@p.CustomerEmail</small></div>
                    }
                </td>
                <td>
                    <strong class="text-dark font-size-15">₹@p.Amount.ToString("N2")</strong>
                    @if (p.RefundedAmount > 0)
                    {
                        <div class="text-danger" style="font-size: 0.78rem;">Refunded: ₹@p.RefundedAmount.ToString("N2")</div>
                    }
                </td>
                <td>
                    @switch (p.Status)
                    {
                        case PaymentStatus.Paid:
                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Paid</span>
                            break;
                        case PaymentStatus.Pending:
                            <span class="badge badge-warning px-2 py-1 text-dark"><i class="fas fa-hourglass-half mr-1"></i>Pending</span>
                            break;
                        case PaymentStatus.Failed:
                            <span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle mr-1"></i>Failed</span>
                            break;
                        case PaymentStatus.Refunded:
                            <span class="badge badge-info px-2 py-1"><i class="fas fa-undo mr-1"></i>Refunded</span>
                            break;
                        case PaymentStatus.PartiallyRefunded:
                            <span class="badge badge-info px-2 py-1"><i class="fas fa-undo mr-1"></i>Partially Refunded</span>
                            break;
                        default:
                            <span class="badge badge-secondary px-2 py-1">@p.Status</span>
                            break;
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(p.GatewayName))
                    {
                        <div><small class="badge badge-light border">@p.GatewayName</small></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.GatewayTransactionId))
                    {
                        <div class="text-truncate text-monospace" style="max-width: 150px; font-size: 0.8rem;" title="@p.GatewayTransactionId">
                            <i class="fas fa-receipt text-muted mr-1"></i>@p.GatewayTransactionId
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(p.GatewayOrderId))
                    {
                        <div class="text-truncate text-monospace text-muted" style="max-width: 150px; font-size: 0.8rem;" title="@p.GatewayOrderId">
                            Ord: @p.GatewayOrderId
                        </div>
                    }
                    else
                    {
                        <small class="text-muted">-</small>
                    }
                </td>
                <td>
                    <div><small>@((p.PaidAt ?? p.CreatedAt).ToString("dd-MMM-yyyy"))</small></div>
                    <div><small class="text-muted">@((p.PaidAt ?? p.CreatedAt).ToString("hh:mm tt"))</small></div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm btn-view" onclick="showPaymentDetails(this)"
                            data-id="@p.Id"
                            data-paymentnumber="@p.PaymentNumber"
                            data-bookingid="@p.BookingId"
                            data-bookingno="@p.BookingNo"
                            data-customername="@p.CustomerName"
                            data-customeremail="@p.CustomerEmail"
                            data-customerphone="@p.CustomerPhone"
                            data-amount="@p.Amount.ToString("N2")"
                            data-currency="@p.Currency"
                            data-status="@p.Status.ToString()"
                            data-gatewayname="@p.GatewayName"
                            data-gatewaytransactionid="@p.GatewayTransactionId"
                            data-gatewayorderid="@p.GatewayOrderId"
                            data-paidat="@(p.PaidAt.HasValue ? p.PaidAt.Value.ToString("dd-MMM-yyyy hh:mm tt") : "")"
                            data-createdat="@p.CreatedAt.ToString("dd-MMM-yyyy hh:mm tt")"
                            data-refundedamount="@(p.RefundedAmount > 0 ? p.RefundedAmount.ToString("N2") : "")"
                            data-refundedat="@(p.RefundedAt.HasValue ? p.RefundedAt.Value.ToString("dd-MMM-yyyy hh:mm tt") : "")"
                            data-failurereason="@p.FailureReason"
                            data-bookingrate="@p.BookingTotalAmount.ToString("N2")"
                            data-traveldate="@(p.TravelDate.HasValue ? p.TravelDate.Value.ToString("dd-MMM-yyyy") : "")"
                            data-pickuplocation="@p.PickupLocation"
                            data-droplocation="@p.DropLocation"
                            title="View Payment Details">
                        <i class="fas fa-eye"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
}
else
{
    <tbody>
        <tr>
            <td colspan="9" class="text-center py-4 text-muted">
                <i class="fas fa-money-check-alt fa-2x mb-2 d-block text-secondary"></i>
                No payments found matching the selected filters.
            </td>
        </tr>
    </tbody>
}

