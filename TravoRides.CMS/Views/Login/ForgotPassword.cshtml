@* @using TravoRides.Application.DTOs.Authentication
@model ForgotPasswordRequest *@


@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Travo Rides | CMS | User Log in</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/plugins/toastr/toastr.min.css">
    <link href="~/dist/css/loginpage.css" rel="stylesheet" />
</head>
<body class="hold-transition login-page">
    <div class="login-box">
         <div class="login-logo">
            
            <img src="~/images/travorides_logo.png" alt="TravoRides Logo" class="img-fluid" style="max-height: 70px;" />
        </div> 
        <!-- /.login-logo -->
        

        <div class="card-body">

            <!-- Email -->
            <div id="email-section">

                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           id="Email"
                           class="form-control"
                           placeholder="Enter your email" />
                </div>

                <button type="button"
                        class="btn btn-primary btn-block"
                        onclick="sendForgotPasswordOtp()">
                    Send OTP
                </button>

            </div>

            <!-- OTP -->
            <div id="otp-section" style="display:none;">

                <div class="form-group">
                    <label>Enter OTP</label>
                    <input type="text"
                           id="OTP"
                           class="form-control"
                           maxlength="6"
                           placeholder="Enter OTP" />
                </div>

                <button type="button"
                        class="btn btn-primary btn-block"
                        onclick="verifyPasswordResetOtp()">
                    Verify OTP
                </button>

            </div>

            <!-- Reset Password -->
            <div id="reset-password-section" style="display:none;">

                <div class="form-group">
                    <label>New Password</label>
                    <input type="password"
                           id="NewPassword"
                           class="form-control" />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password"
                           id="ConfirmPassword"
                           class="form-control" />
                </div>

                <button type="button"
                        class="btn btn-success btn-block"
                        onclick="resetPassword()">
                    Reset Password
                </button>

            </div>

        </div>
    



            </div>
        </div>
    </div>
    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/loginmodule.js"></script>
    <script src="~/js/ForgotPasswordModule.js"></script>
</body>
</html>


