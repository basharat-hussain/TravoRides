@using AlArwaSolutions.Application.DTOs.Client
@using AlArwaSolutions.Application.DTOs.Common
@model PagedResponse<ClientDTO>


@if (Model.Items.Count() > 0)
{
    <thead>
        <tr>
            <th style="width: 5%">
                S.No
            </th>

            <th style="width: 20%">
                CompanyName
            </th>

            <th style="width: 10%">
                Address
            </th>

            <th style="width: 10%">
                Logo
            </th>
            <th style="width: 15%">
                 Email
            </th>
            <th style="width: 25%" class="text-center">
                Description
                </th>
            <th style="width: 10%" class="text-center">
                Actions
            </th>
           <th style="width: 5%" class="text-center">
                View
            </th>
        </tr>
    </thead>

    <tbody>
        @{ int count = 1;}
        @foreach (var client in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@client.Id" />

                </td>

                <td class="name">@client.Name</td>

                <td>@client.Address</td>

                <td><img src="@client.LogoUrl" class="img-fluid" style="height:80px; width:200px;" /></td>
                <td>
                    @client.Email<br />
                    </td>
                 <td>
                    @{ var fb = client.Description ?? string.Empty; }
                    @((fb.Length > 50) ? fb.Substring(0, 50) + "..." : fb)
                </td>


                <td class="project-actions text-center">

                    <a asp-controller="Client" asp-action="Edit" asp-route-id="@client.Id" class="btn btn-warning btn-sm" data-toggle="tooltip" data-placement="top" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a class="btn btn-danger btn-sm btn-delete" href="#" data-toggle="modal" data-target="#modal-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                  <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm btn-view" onclick="showReviewDetails(this)"
                            data-id="@client.Id"
                            data-name="@client.Name"
                            data-address="@client.Address"
                            data-logourl="@client.LogoUrl"
                            data-email="@client.Email"
                            data-description="@client.Description"
                             data-image="@client.LogoUrl"
                           >
                        View
                    </button>
                    </td>
            </tr>
        }



    </tbody>
}
else
{
    <tr>
        <td>Sorry! No Clients found</td>
    </tr>}
