@using AlArwaSolutions.Application.Common.Responses
@using AlArwaSolutions.Application.DTOs.Client
@using AlArwaSolutions.Application.DTOs.Common
@model ApiResponse<PagedResponse<ClientDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Clients</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Clients</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Clients</h3>

            <div class="card-tools">
                <a asp-controller="Client" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> &nbsp; Add Client
                </a>

            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_ClientsPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Client";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var name = $btn.data('name') || '';
        var address = $btn.data('address') || '';
        var email = $btn.data('email') || '';
        var description = $btn.data('description') || '';
        var logourl = $btn.data('logourl') || '';

        var html = '<div class="row">';
        html += '<div class="col-md-4">';
        if (logourl) {
            html += '<img src="' + logourl + '" class="img-fluid" />';
        }
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Company Name:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Address:</strong> ' + $('<div/>').text(address).html() + '</p>';
        html += '<p><strong>Email:</strong> ' + $('<div/>').text(email).html() + '</p>';
        html += '<p><strong>Description:</strong><br />' + $('<div/>').text(description).html().replace(/\n/g, '<br/>') + '</p>';
        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Client');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>