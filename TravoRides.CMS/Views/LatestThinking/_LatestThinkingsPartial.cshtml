@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.LatestThinking
@model PagedResponse<LatestThinkingDTO>

@if (Model != null && Model.Items.Any())
{
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 10%" class="text-center">Thumbnail</th>
            <th style="width: 20%">Title</th>
            <th style="width: 15%">SubTitle</th>
            <th style="width: 12%">Author</th>
            <th style="width: 16%">Summary</th>
            <th style="width: 12%" class="text-center">Actions</th>
            <th style="width: 10%" class="text-center">View</th>
        </tr>
    </thead>

    <tbody>
        @{ int count = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
        @foreach (var latestThinking in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@latestThinking.Id" />
                </td>

                <td class="text-center">
                    @if (!string.IsNullOrWhiteSpace(latestThinking.ImageUrl))
                    {
                        <img src="@latestThinking.ImageUrl" alt="@latestThinking.Title" class="rounded border shadow-sm" style="width: 54px; height: 38px; object-fit: cover;" onerror="this.onerror=null;this.src='/dist/img/200x80.png';" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-inline-flex align-items-center justify-content-center text-muted" style="width: 54px; height: 38px;">
                            <i class="fas fa-newspaper"></i>
                        </div>
                    }
                </td>

                <td class="name font-weight-bold text-dark">@latestThinking.Title</td>
                <td class="text-muted small">@latestThinking.Subtitle</td>
                <td>
                    <span class="badge badge-light border text-primary px-2 py-1">
                        <i class="fas fa-user-edit mr-1"></i>@latestThinking.Author
                    </span>
                </td>
                <td class="text-muted small">
                    @{
                        var fb = latestThinking.Summary ?? latestThinking.Description ?? string.Empty;
                        var truncated = fb.Length > 60
                            ? fb.Substring(0, 60) + "..."
                            : fb;
                    }
                    @truncated
                </td>
                <td class="project-actions text-center">
                    <a asp-controller="LatestThinking" asp-action="Edit" asp-route-id="@latestThinking.Id" class="btn btn-warning btn-sm" data-toggle="tooltip" data-placement="top" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a class="btn btn-danger btn-sm btn-delete" href="#" data-toggle="modal" data-target="#modal-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-info btn-sm btn-view" onclick="showLatestThinkingDetails(this)"
                            data-id="@latestThinking.Id"
                            data-title="@latestThinking.Title"
                            data-subtitle="@latestThinking.Subtitle"
                            data-author="@latestThinking.Author"
                            data-canonicalurl="@latestThinking.CanonicalUrl"
                            data-summary="@latestThinking.Summary"
                            data-metatitle="@latestThinking.MetaTitle"
                            data-metadescription="@latestThinking.MetaDescription"
                            data-takeaways="@latestThinking.KeyTakeaways"
                            data-slug="@latestThinking.Slug"
                            data-description="@latestThinking.Description"
                            data-imageurl="@latestThinking.ImageUrl"
                            data-image="@latestThinking.ImageUrl"
                            data-altimage="@latestThinking.ImageAltText">
                        <i class="fas fa-eye mr-1"></i> View
                    </button>
                </td>
            </tr>
        }
    </tbody>
}
else
{
    <tbody>
        <tr>
            <td colspan="8" class="text-center py-4 text-muted">Sorry! No Latest Thinking found</td>
        </tr>
    </tbody>
}
