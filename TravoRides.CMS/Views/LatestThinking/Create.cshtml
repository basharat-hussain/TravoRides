@using AlArwaSolutions.Application.DTOs.LatestThinking
@model CreateLatestThinkingRequest
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Latest Thinkings Add</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Latest Thinking</a></li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="offset-md-2 col-md-8">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Add Latest Thinking</h3>

                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <form id="addform" enctype="multipart/form-data" asp-controller="LatestThinking" asp-action="Create" asp-antiforgery="false" data-ajax="true" data-ajax-method="post" data-ajax-success="onSuccess" data-ajax-failure="onFailure" data-ajax-begin="onBegin">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Title</label>
                                    <input asp-for="Title" class="form-control" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Subtitle</label>
                                    <input asp-for="Subtitle" class="form-control" />
                                    <span asp-validation-for="Subtitle" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>ImageAltText</label>
                                    <input asp-for="ImageAltText" class="form-control" />
                                    <span asp-validation-for="ImageAltText" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Author</label>
                                    <input asp-for="Author" class="form-control" />
                                    <span asp-validation-for="Author" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>TakeAways</label>
                                    <input asp-for="KeyTakeaways" class="form-control" rows="4" />
                                    <span asp-validation-for="KeyTakeaways" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>MetaTitle</label>
                                    <input asp-for="MetaTitle" class="form-control" rows="4" />
                                    <span asp-validation-for="MetaTitle" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                       
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>MetaDescription</label>
                                    <input asp-for="MetaDescription" class="form-control" rows="4" />
                                    <span asp-validation-for="MetaDescription" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Slug</label>
                                    <input asp-for="Slug" class="form-control" rows="4" />
                                    <span asp-validation-for="Slug" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                       
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>CanonicalUrl</label>
                                    <input asp-for="CanonicalUrl" class="form-control" rows="4" />
                                    <span asp-validation-for="CanonicalUrl" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Summary</label>
                                    <input asp-for="Summary" class="form-control" rows="4" />
                                    <span asp-validation-for="Summary" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Image</label>
                                    <input asp-for="ImageUrl" class="form-control img-uploader" type="file" accept=".png, .jpeg, .jpg" />
                                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <img src="~/dist/img/200x80.png" class="image-previewer" style="height: 100px; width:200px" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea asp-for="Description" class="form-control text-editor"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-success save-btn"><i class="fas fa-save"></i> Save</button>
                            <button type="reset" class="btn btn-danger"><i class="fas fa-recycle"></i> Reset</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>

</section>

<partial name="_ValidationScriptsPartial" />

<script>
    var module = "LatestThinking";
</script>

<script src="~/js/managemodule.js"></script>