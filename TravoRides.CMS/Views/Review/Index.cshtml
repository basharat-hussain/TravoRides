@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Review
@model ApiResponse<PagedResponse<ReviewDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Reviews</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Reviews</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Reviews</h3>

          
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_ReviewsPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Review";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var name = $btn.data('name') || '';
        var address = $btn.data('address') || '';
        var feedback = $btn.data('feedback') || '';
        var rating = parseInt($btn.data('rating') || '0', 10);
        var image = $btn.data('imageurl') || $btn.data('image') || '';
        var isActive = $btn.data('isactive') === true || $btn.data('isactive') === "true";

        var html = '<div class="row align-items-center">';
        
        // Avatar & Rating Column
        html += '<div class="col-md-4 text-center mb-3 mb-md-0">';
        if (image) {
            html += '<img src="' + image + '" class="img-fluid rounded-circle border shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="' + $('<div/>').text(name).html() + '" onerror="this.onerror=null;this.src=\'/dist/img/user1-128x128.jpg\';" />';
        } else {
            html += '<div class="rounded-circle border bg-light d-inline-flex align-items-center justify-content-center text-muted shadow-sm" style="width: 100px; height: 100px;"><i class="fas fa-user-circle fa-4x"></i></div>';
        }
        
        // Star rating
        html += '<div class="mt-2 text-warning">';
        for (var i = 1; i <= 5; i++) {
            if (i <= rating) {
                html += '<i class="fas fa-star mr-1"></i>';
            } else {
                html += '<i class="far fa-star text-muted mr-1"></i>';
            }
        }
        html += '<div class="small font-weight-bold text-muted mt-1">' + rating + ' out of 5 stars</div>';
        html += '</div>';

        html += '<div class="mt-2">';
        if (isActive) {
            html += '<span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Approved</span>';
        } else {
            html += '<span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle mr-1"></i>Unapproved</span>';
        }
        html += '</div>';

        html += '</div>';

        // Details Column
        html += '<div class="col-md-8">';
        html += '<h4 class="font-weight-bold text-dark mb-1">' + $('<div/>').text(name).html() + '</h4>';
        if (address) {
            html += '<div class="text-muted small mb-3"><i class="fas fa-map-marker-alt text-danger mr-1"></i>' + $('<div/>').text(address).html() + '</div>';
        }

        html += '<div class="p-3 bg-light rounded border">';
        html += '<h6 class="font-weight-bold text-muted small text-uppercase mb-2"><i class="fas fa-comment-dots text-primary mr-1"></i>Customer Feedback</h6>';
        html += '<p class="text-secondary mb-0 font-italic" style="line-height: 1.6;">"' + $('<div/>').text(feedback).html().replace(/\n/g, '<br/>') + '"</p>';
        html += '</div>';

        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Review Details');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
</script>
<script src="~/js/managemodule.js"></script>

<script>
function toggleReviewStatus(id, button) {

const $button = $(button);

// If button is red, review is currently approved
const isActive = $button.hasClass("btn-danger");

const action = isActive ? "unapprove" : "approve";

Swal.fire({
title: 'Are you sure?',
text: `Do you want to ${action} this review?`,
icon: 'warning',
showCancelButton: true,
confirmButtonColor: '#28a745',
cancelButtonColor: '#d33',
confirmButtonText: `Yes, ${action} it`,
cancelButtonText: 'Cancel'
}).then((result) => {

if (!result.isConfirmed) {
return;
}

$.ajax({
url: '/Review/ToggleReviewStatus',
type: 'POST',
data: {
id: id
},

beforeSend: function () {
$button.prop('disabled', true);
},

success: function (res) {

if (res.success) {

if (res.status) {

// Review is now APPROVED
$button
.removeClass('btn-success')
.addClass('btn-danger')
.text('Unapprove');

toastr.success('Review approved successfully.');

} else {

// Review is now UNAPPROVED
$button
.removeClass('btn-danger')
.addClass('btn-success')
.text('Approve');

toastr.success('Review unapproved successfully.');
}

} else {

toastr.error(
res.message || 'Unable to update review status.'
);
}
},

error: function () {
toastr.error(
'Something went wrong while updating the review status.'
);
},

complete: function () {
$button.prop('disabled', false);
}
});
});
}
</script>