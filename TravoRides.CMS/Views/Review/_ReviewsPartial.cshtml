@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Review
@model PagedResponse<ReviewDTO>
<style>
    .rating .active {
        color: #ffc107; /* yellow */
    }
    .rating .inactive {
        color: #ccc; /* grey */
    }
</style>
@if (Model != null && Model.Items.Any())
{
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 8%" class="text-center">User</th>
            <th style="width: 18%">Name</th>
            <th style="width: 18%">Address</th>
            <th style="width: 12%">Rating</th>
            <th style="width: 21%">Feedback</th>
            <th style="width: 10%" class="text-center">Status</th>
            <th style="width: 8%" class="text-center">View</th>
        </tr>
    </thead>

    <tbody>
        @{ int count = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
        @foreach (var review in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@review.Id" />
                </td>

                <td class="text-center">
                    @if (!string.IsNullOrWhiteSpace(review.ImageUrl))
                    {
                        <img src="@review.ImageUrl" alt="@review.Name" class="rounded-circle border shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.onerror=null;this.src='/dist/img/user1-128x128.jpg';" />
                    }
                    else
                    {
                        <div class="rounded-circle border bg-light d-inline-flex align-items-center justify-content-center text-muted" style="width: 38px; height: 38px;">
                            <i class="fas fa-user-circle fa-lg"></i>
                        </div>
                    }
                </td>

                <td class="name font-weight-bold text-dark">@review.Name</td>
                <td class="text-muted small">@review.Address</td>

                <td class="rating">
                    @{
                        int Rating = Convert.ToInt32(review.Rating);
                    }
                    @for (int i = 1; i <= Rating; i++)
                    {
                        <i class="fa fa-star active"></i>
                    }
                    @for (int i = Rating; i < 5; i++)
                    {
                        <i class="fa fa-star inactive"></i>
                    }
                </td>

                <td class="small text-secondary">
                    @{ var fb = review.Feedback ?? string.Empty; }
                    @((fb.Length > 55) ? fb.Substring(0, 55) + "..." : fb)
                </td>

                <td class="text-center">
                    <button type="button"
                            class="btn btn-sm @(review.IsActive ? "btn-success" : "btn-danger")"
                            onclick="toggleReviewStatus('@review.Id', this)">
                        @(review.IsActive ? "Approved" : "Unapproved")
                    </button>
                </td>

                <td class="text-center">
                    <button type="button" class="btn btn-outline-info btn-sm btn-view" onclick="showReviewDetails(this)"
                            data-id="@review.Id"
                            data-name="@review.Name"
                            data-address="@review.Address"
                            data-feedback="@review.Feedback"
                            data-rating="@review.Rating"
                            data-imageurl="@review.ImageUrl"
                            data-image="@review.ImageUrl"
                            data-isactive="@(review.IsActive ? "true" : "false")">
                        <i class="fas fa-eye mr-1"></i> View
                    </button>
                </td>
            </tr>
        }
    </tbody>
}
else
{
    <tbody>
        <tr>
            <td colspan="8" class="text-center py-4 text-muted">Sorry! No Reviews found</td>
        </tr>
    </tbody>
}
