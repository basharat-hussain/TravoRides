@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Transit
@using TravoRides.Application.DTOs.Common
@model ApiResponse<PagedResponse<TransitDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Transits</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Transits</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Transits</h3>

            <div class="card-tools">
                <a asp-controller="Transit" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> &nbsp; Add Transit
                </a>

            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_TransitsPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Transit";
</script>

<script>
    function showTransitDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var title = $btn.data('title') || $btn.data('name') || '';
        var price = $btn.data('price') || '';
        var discount = $btn.data('discount') || '';
        var description = $btn.data('description') || '';
        var imageurl = $btn.data('imageurl') || $btn.data('image') || '';

        var html = '<div class="row align-items-start">';
        
        // Image Column
        html += '<div class="col-md-5 mb-3">';
        if (imageurl) {
            html += '<img src="' + imageurl + '" class="img-fluid rounded border shadow-sm w-100" style="max-height: 220px; object-fit: cover;" alt="' + $('<div/>').text(title).html() + '" onerror="this.onerror=null;this.src=\'/dist/img/200x100.png\';" />';
        } else {
            html += '<div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted shadow-sm" style="height: 180px;"><i class="fas fa-route fa-4x"></i></div>';
        }
        html += '<div class="mt-3 p-3 bg-light rounded border text-center">';
        html += '<div class="text-muted small text-uppercase font-weight-bold">Transit Price</div>';
        html += '<div class="text-success font-weight-bold h4 mb-0">' + $('<div/>').text(price).html() + '</div>';
        if (discount && discount !== 'None' && discount !== '₹0') {
            html += '<span class="badge badge-warning text-dark mt-1 font-weight-bold"><i class="fas fa-tag mr-1"></i>Discount: ' + $('<div/>').text(discount).html() + '</span>';
        }
        html += '</div>';
        html += '</div>';

        // Details Column
        html += '<div class="col-md-7">';
        html += '<h4 class="font-weight-bold text-dark mb-3">' + $('<div/>').text(title).html() + '</h4>';

        if (description) {
            html += '<div class="mb-3">';
            html += '<h6 class="font-weight-bold text-muted small text-uppercase mb-1">Description</h6>';
            html += '<p class="text-secondary small mb-0" style="line-height: 1.6;">' + $('<div/>').text(description).html().replace(/\n/g, '<br/>') + '</p>';
            html += '</div>';
        }

        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Transit Details');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }

    function showReviewDetails(btn) {
        showTransitDetails(btn);
    }
</script>
<script src="~/js/managemodule.js"></script>