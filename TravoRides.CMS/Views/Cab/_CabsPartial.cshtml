@using TravoRides.Application.DTOs.Cabs
@using TravoRides.Application.DTOs.Common
@model PagedResponse<CabDTO>


@if (Model.Items.Count() > 0)
{
    <thead>
        <tr>
            <th style="width: 10%">
                S.No
            </th>

            <th style="width: 20%">
                Category
            </th>

            <th style="width: 20%">
                Name
            </th>

            <th style="width: 15%">
                Price
            </th>
            <th style="width: 15%">
                 Discount
            </th>
           
            <th style="width: 10%" class="text-center">
                Actions
            </th>
           <th style="width: 10%" class="text-center">
                View
            </th>
        </tr>
    </thead>

    <tbody>
        @{ int count = 1;}
        @foreach (var Cab in Model.Items)
        {
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@Cab.Id" />

                </td>

                <td class="name">@Cab.Category</td>

                <td>@Cab.Name</td>

                <td>@Cab.PricePerDay </td>
               <td>@Cab.Discount</td>


                <td class="project-actions text-center">

                    <a asp-controller="Cab" asp-action="Edit" asp-route-id="@Cab.Id" class="btn btn-warning btn-sm" data-toggle="tooltip" data-placement="top" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a class="btn btn-danger btn-sm btn-delete" href="#" data-toggle="modal" data-target="#modal-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                  <td class="text-center">
                    <button type="button" class="btn btn-info btn-sm btn-view" onclick="showReviewDetails(this)"
                            data-id="@Cab.Id"
                            data-name="@Cab.Name"
                            data-category="@Cab.Category"
                            data-price="@Cab.PricePerDay"
                            data-discount="@Cab.Discount"
                            data-fuel="@Cab.Fuel"
                            data-transmission="@Cab.Transmission"
                            data-description="@Cab.Description"
                            data-image="@Cab.ImageUrl"
                           >
                        View
                    </button>
                    </td>
            </tr>
        }



    </tbody>
}
else
{
    <tr>
        <td>Sorry! No Cabs found</td>
    </tr>}
