@using TravoRides.Application.DTOs.Cabs
@using TravoRides.Domain.Enums
@model UpdateCabRequest

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Cab Edit</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Cab/Index">Cab</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->

<section class="content">
    <div class="row">
        @if (Model is null)
        {
            <div class="offset-md-2 col-md-8 mt-4">
                <div class="alert alert-warning text-center"><i class="fas fa-frown fa-4x"></i><h3 class="mt-2">Sorry! Category Details not found</h3></div>
            </div>
        }
        else
        {

            <div class="offset-md-2 col-md-8">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Edit Cab</h3>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form id="editform" enctype="multipart/form-data" asp-controller="Cab" asp-action="Edit" asp-antiforgery="false" data-ajax="true" data-ajax-method="post" data-ajax-success="onSuccess" data-ajax-failure="onFailure" data-ajax-begin="onBegin">
                            <input type="hidden" asp-for="Id" />
                            <div class="row">

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CategoryId" class="form-control">Category</label>

                                        <select asp-for="CategoryId" class="form-control">
                                            <option value="">-- Select Category --</option>

                                            @foreach (var category in ViewBag.Categories)
                                            {
                                                <option value="@category.Id">
                                                    @category.Name
                                                </option>
                                            }
                                        </select>

                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">

                                    <label asp-for="Fuel" class="form-label">Fuel Type</label>

                                    <select asp-for="Fuel"
                                            asp-items="Html.GetEnumSelectList<FuelType>()"
                                            class="form-control">
                                        <option value="">-- Select Fuel Type --</option>
                                    </select>

                                    <span asp-validation-for="Fuel" class="text-danger"></span>

                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input asp-for="Name" class="form-control" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Transmission</label>
                                        <input asp-for="Transmission" class="form-control" rows="4" />
                                        <span asp-validation-for="Transmission" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Price</label>
                                        <input asp-for="PricePerDay" class="form-control" />
                                        <span asp-validation-for="PricePerDay" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Discount</label>
                                        <input asp-for="Discount" class="form-control" rows="4" />
                                        <span asp-validation-for="Discount" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Seating Capacity</label>
                                        <input asp-for="SeatingCapacity" class="form-control" />
                                        <span asp-validation-for="SeatingCapacity" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Luggage</label>
                                        <input asp-for="LuggageCapacity" class="form-control" rows="4" />
                                        <span asp-validation-for="LuggageCapacity" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Logo</label>
                                        <input asp-for="Image" class="form-control img-uploader" accept=".png, .jpeg, .jpg" />
                                        <span asp-validation-for="Image" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-group">
                                        <img src="@Model.ImageUrl" class="image-previewer" style="height: 80px; width:200px" />
                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Description</label>
                                        <textarea asp-for="Description" class="form-control"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn btn-success save-btn"><i class="fas fa-save"></i> Save</button>
                                <button type="reset" class="btn btn-danger"><i class="fas fa-recycle"></i> Reset</button>
                            </div>
                           
                        </form>

                    </div>
                </div>
            </div>
        }



    </div>

</section>


  
<partial name="_ValidationScriptsPartial" />

  


<script>
    var module = "Cab";
    var operation = "Edit";
</script>

<script src="~/js/managemodule.js"></script>


