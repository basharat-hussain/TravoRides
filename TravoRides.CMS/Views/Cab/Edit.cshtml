@using TravoRides.Application.DTOs.Cabs
@using TravoRides.Application.DTOs.FeaturesMaster
@using TravoRides.Domain.Enums
@model UpdateCabRequest

@{
    var features = ViewBag.Features as IEnumerable<FeaturesMasterDTO> ?? Enumerable.Empty<FeaturesMasterDTO>();
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Edit Cab</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Cab/Index">Cabs</a></li>
                    <li class="breadcrumb-item active">Edit Cab</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            @if (Model is null)
            {
                <div class="col-lg-8 offset-lg-2 mt-4">
                    <div class="alert alert-warning text-center p-4">
                        <i class="fas fa-exclamation-triangle fa-3x mb-3 text-warning"></i>
                        <h4 class="font-weight-bold">Cab Not Found</h4>
                        <p class="mb-3">The requested cab details could not be loaded.</p>
                        <a href="/Cab/Index" class="btn btn-primary"><i class="fas fa-arrow-left mr-1"></i> Back to Cabs</a>
                    </div>
                </div>
            }
            else
            {
                <div class="col-lg-10 offset-lg-1">
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-edit mr-2"></i> Edit Cab: @Model.Name</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <form id="editform" enctype="multipart/form-data" asp-controller="Cab" asp-action="Edit" asp-antiforgery="false" data-ajax="true" data-ajax-method="post" data-ajax-success="onSuccess" data-ajax-failure="onFailure" data-ajax-begin="onBegin">
                                <input type="hidden" asp-for="Id" />

                                <!-- Primary Specs -->
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="CategoryId" class="form-label"><i class="fas fa-th-large text-primary mr-1"></i> Category <span class="text-danger">*</span></label>
                                            <select asp-for="CategoryId" class="form-control">
                                                <option value="">-- Select Category --</option>
                                                @if (ViewBag.Categories != null)
                                                {
                                                    foreach (var category in ViewBag.Categories)
                                                    {
                                                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Fuel" class="form-label"><i class="fas fa-gas-pump text-success mr-1"></i> Fuel Type <span class="text-danger">*</span></label>
                                            <select asp-for="Fuel" asp-items="Html.GetEnumSelectList<FuelType>()" class="form-control">
                                                <option value="">-- Select Fuel Type --</option>
                                            </select>
                                            <span asp-validation-for="Fuel" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Name" class="form-label"><i class="fas fa-font text-info mr-1"></i> Cab Name <span class="text-danger">*</span></label>
                                            <input asp-for="Name" class="form-control" />
                                            <span asp-validation-for="Name" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Transmission" class="form-label"><i class="fas fa-cogs text-secondary mr-1"></i> Transmission <span class="text-danger">*</span></label>
                                            <input asp-for="Transmission" class="form-control" />
                                            <span asp-validation-for="Transmission" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="PricePerDay" class="form-label"><i class="fas fa-rupee-sign text-success mr-1"></i> Price Per Day <span class="text-danger">*</span></label>
                                            <input asp-for="PricePerDay" class="form-control" type="number" step="0.01" />
                                            <span asp-validation-for="PricePerDay" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Discount" class="form-label"><i class="fas fa-rupee-sign text-warning mr-1"></i> Discount (₹)</label>
                                            <input asp-for="Discount" class="form-control" type="number" step="0.01" />
                                            <span asp-validation-for="Discount" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="SeatingCapacity" class="form-label"><i class="fas fa-users text-primary mr-1"></i> Seating Capacity <span class="text-danger">*</span></label>
                                            <input asp-for="SeatingCapacity" class="form-control" type="number" min="1" />
                                            <span asp-validation-for="SeatingCapacity" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="LuggageCapacity" class="form-label"><i class="fas fa-suitcase text-purple mr-1"></i> Luggage Capacity (Bags) <span class="text-danger">*</span></label>
                                            <input asp-for="LuggageCapacity" class="form-control" type="number" min="0" />
                                            <span asp-validation-for="LuggageCapacity" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label"><i class="fas fa-image text-danger mr-1"></i> Update Image (Optional)</label>
                                            <input asp-for="Image" class="form-control img-uploader" accept=".png, .jpeg, .jpg" />
                                            <span asp-validation-for="Image" class="text-danger"></span>
                                            <small class="text-muted d-block mt-1">Leave empty to keep current image</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">Current Image</label>
                                            <div>
                                                <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/dist/img/200x80.png" : Model.ImageUrl)" class="image-previewer" style="height: 100px; width: 220px;" alt="Vehicle Preview" />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label asp-for="Description" class="form-label"><i class="fas fa-align-left text-secondary mr-1"></i> Description</label>
                                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                            <span asp-validation-for="Description" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dedicated Modern Cab Features Selection Section -->
                                <div class="feature-selection-container">
                                    <div class="feature-selection-header">
                                        <div>
                                            <h5 class="feature-selection-title">
                                                <i class="fas fa-star text-warning"></i> Cab Features & Amenities
                                            </h5>
                                            <small class="text-muted">Manage the features and amenities assigned to this cab</small>
                                        </div>
                                        <div class="feature-selection-tools">
                                            <div class="feature-search-box">
                                                <i class="fas fa-search"></i>
                                                <input type="text" id="featureSearchInput" placeholder="Search features..." />
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectAllFeatures">
                                                <i class="fas fa-check-double"></i> All
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearAllFeatures">
                                                <i class="fas fa-times"></i> Clear
                                            </button>
                                            <span class="feature-count-badge" id="selectedFeaturesBadge">0 selected</span>
                                        </div>
                                    </div>

                                    @if (features.Any())
                                    {
                                        <div class="features-grid" id="featuresGrid">
                                            @foreach (var feature in features)
                                            {
                                                var isSelected = Model.FeatureIds != null && Model.FeatureIds.Contains(feature.Id);
                                                var iconClass = string.IsNullOrWhiteSpace(feature.Icon) ? "fas fa-check-circle" : feature.Icon;
                                                if (!iconClass.Contains("fa-")) iconClass = "fas fa-check-circle";

                                                <div class="feature-card @(isSelected ? "selected" : "")" data-title="@feature.Title.ToLower()" data-desc="@(feature.Description?.ToLower() ?? "")">
                                                    <input type="checkbox" name="FeatureIds" value="@feature.Id" class="feature-checkbox d-none" @(isSelected ? "checked=\"checked\"" : "") />
                                                    <div class="feature-card-icon">
                                                        <i class="@iconClass"></i>
                                                    </div>
                                                    <div class="feature-card-content">
                                                        <div class="feature-card-title" title="@feature.Title">@feature.Title</div>
                                                        <div class="feature-card-desc">@(string.IsNullOrWhiteSpace(feature.Description) ? "Included with vehicle" : feature.Description)</div>
                                                    </div>
                                                    <div class="feature-card-check">
                                                        <i class="fas fa-check"></i>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-light text-center border p-4 mb-0">
                                            <i class="fas fa-info-circle text-info fa-2x mb-2 d-block"></i>
                                            <p class="mb-1 font-weight-bold">No features found in Feature Master table.</p>
                                            <small class="text-muted">You can add master features anytime under the <a href="/FeatureMaster/Create" target="_blank" class="font-weight-bold text-primary">Cab Features</a> menu.</small>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="form-group pt-2 mb-0 d-flex gap-2">
                                    <button type="submit" class="btn btn-success save-btn mr-2">
                                        <i class="fas fa-save mr-1"></i> Update Cab
                                    </button>
                                    <a href="/Cab/Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-left mr-1"></i> Cancel
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Cab";
    var operation = "Edit";

    $(function() {
        function updateFeatureCount() {
            var count = $('.feature-checkbox:checked').length;
            $('#selectedFeaturesBadge').text(count + ' selected');
        }

        // Feature card toggle
        $(document).on('click', '.feature-card', function(e) {
            if ($(e.target).is('input')) return;
            var $chk = $(this).find('.feature-checkbox');
            var isChecked = !$chk.prop('checked');
            $chk.prop('checked', isChecked).trigger('change');
        });

        // Checkbox change updates UI
        $(document).on('change', '.feature-checkbox', function() {
            var $card = $(this).closest('.feature-card');
            if ($(this).is(':checked')) {
                $card.addClass('selected');
            } else {
                $card.removeClass('selected');
            }
            updateFeatureCount();
        });

        // Select All visible
        $('#btnSelectAllFeatures').on('click', function() {
            $('.feature-card:visible').each(function() {
                var $chk = $(this).find('.feature-checkbox');
                if (!$chk.prop('checked')) {
                    $chk.prop('checked', true).trigger('change');
                }
            });
        });

        // Clear All
        $('#btnClearAllFeatures').on('click', function() {
            $('.feature-checkbox').prop('checked', false).trigger('change');
        });

        // Live search filter
        $('#featureSearchInput').on('input', function() {
            var term = $(this).val().toLowerCase().trim();
            $('.feature-card').each(function() {
                var title = $(this).data('title') || '';
                var desc = $(this).data('desc') || '';
                if (title.indexOf(term) > -1 || desc.indexOf(term) > -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        updateFeatureCount();
    });
</script>

<script src="~/js/managemodule.js"></script>

