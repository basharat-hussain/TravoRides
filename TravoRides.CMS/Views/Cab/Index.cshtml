@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Cabs
@using TravoRides.Application.DTOs.Common
@model ApiResponse<PagedResponse<CabDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Cabs</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Cabs</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Cabs</h3>

            <div class="card-tools">
                <a asp-controller="Cab" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> &nbsp; Add Cab
                </a>

            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_CabsPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Cab";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var category = $btn.data('category') || '';
        var name = $btn.data('name') || '';
        var price = $btn.data('price') || '';
        var discount = $btn.data('discount') || '';
        var transmission = $btn.data('transmission') || '';
        var luggage = $btn.data('luggage') || '';
                var seating = $btn.data('seating') || '';

        var fuel = $btn.data('fuel') || '';
        var description = $btn.data('description')|| '';
        var isSelfDrive = $btn.data('isSelfDrive') || '';
        var imageurl = $btn.data('imageurl') || '';

        var html = '<div class="row">';
        html += '<div class="col-md-4">';
        if (imageurl) {
            html += '<img src="' + imageurl + '" class="img-fluid" />';
        }
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Category:</strong> ' + $('<div/>').text(category).html() + '</p>';
        html += '<p><strong>Name:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Price:</strong> ' + $('<div/>').text(price).html() + '</p>';
        html += '<p><strong>Discount:</strong> ' + $('<div/>').text(discount).html() + '</p>';
        html += '<p><strong>Transmission:</strong> ' + $('<div/>').text(transmission).html() + '</p>';
        html += '<p><strong>FuelType:</strong> ' + $('<div/>').text(fuel).html() + '</p>';
         html += '<p><strong>Luggage:</strong> ' + $('<div/>').text(luggage).html() + '</p>';

        html += '<p><strong>SeatingCapacity:</strong> ' + $('<div/>').text(seating).html() + '</p>';

        html += '<p><strong>Description:</strong><br />' + $('<div/>').text(description).html().replace(/\n/g, '<br/>') + '</p>';
        html += '<p><strong>IsSelfDrive:</strong> ' + $('<div/>').text(isSelfDrive).html() + '</p>';

        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Cab');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>