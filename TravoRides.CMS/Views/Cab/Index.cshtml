@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Cabs
@using TravoRides.Application.DTOs.Common
@model ApiResponse<PagedResponse<CabDTO>>

<!-- Breadcrumb -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Fleet Management</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Cabs</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <div>
                    <h3 class="card-title">All Cabs</h3>
                    <small class="text-muted d-block mt-1">Manage vehicles, rates, categories, and attached amenities</small>
                </div>
                <div class="card-tools">
                    <a asp-controller="Cab" asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus mr-1"></i> Add Cab
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover dataTable" id="data-grid">
                        @await Html.PartialAsync("_CabsPartial", Model?.Data)
                    </table>
                </div>
            </div>
            <div class="card-footer clearfix">
                @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model?.Data)
            </div>
        </div>
    </div>
</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Cab";

    function showCabDetails(btn) {
        var $btn = $(btn);
        var name = $btn.data('name') || '';
        var category = $btn.data('category') || '';
        var price = $btn.data('price') || '';
        var discount = $btn.data('discount') || '';
        var fuel = $btn.data('fuel') || '';
        var transmission = $btn.data('transmission') || '';
        var seating = $btn.data('seating') || '';
        var luggage = $btn.data('luggage') || '';
        var description = $btn.data('description') || '';
        var selfdrive = $btn.data('selfdrive') || '';
        var imageurl = $btn.data('imageurl') || '';
        var featuresRaw = $btn.attr('data-features') || '[]';

        var features = [];
        try {
            features = JSON.parse(featuresRaw);
        } catch (e) {
            console.error("Error parsing features JSON:", e);
        }

        var html = '<div class="row align-items-start">';
        
        // Image Column
        html += '<div class="col-md-5 mb-3">';
        if (imageurl) {
            html += '<img src="' + imageurl + '" class="img-fluid rounded border shadow-sm w-100" style="max-height: 220px; object-fit: cover;" alt="' + $('<div/>').text(name).html() + '" />';
        } else {
            html += '<div class="rounded border bg-light d-flex align-items-center justify-content-center" style="height: 180px;"><i class="fas fa-car fa-4x text-muted"></i></div>';
        }
        html += '<div class="mt-3 p-3 bg-light rounded border text-center">';
        html += '<div class="text-muted small text-uppercase font-weight-bold">Daily Rental</div>';
        html += '<div class="text-success font-weight-bold h4 mb-0">' + $('<div/>').text(price).html() + '</div>';
        if (discount && discount !== 'None') {
            html += '<span class="badge badge-warning text-dark mt-1 font-weight-bold"><i class="fas fa-tag mr-1"></i>Discount: ' + $('<div/>').text(discount).html() + '</span>';
        }
        html += '</div>';
        html += '</div>';

        // Details Column
        html += '<div class="col-md-7">';
        html += '<span class="badge badge-primary px-2 py-1 font-weight-bold mb-2">' + $('<div/>').text(category).html() + '</span>';
        html += '<h4 class="font-weight-bold text-dark mb-3">' + $('<div/>').text(name).html() + '</h4>';

        // Vehicle Specs
        html += '<div class="d-flex flex-wrap mb-3">';
        html += '<span class="spec-pill"><i class="fas fa-gas-pump"></i> ' + $('<div/>').text(fuel).html() + '</span>';
        html += '<span class="spec-pill"><i class="fas fa-cogs"></i> ' + $('<div/>').text(transmission).html() + '</span>';
        html += '<span class="spec-pill"><i class="fas fa-users"></i> ' + $('<div/>').text(seating).html() + ' Seats</span>';
        html += '<span class="spec-pill"><i class="fas fa-suitcase"></i> ' + $('<div/>').text(luggage).html() + ' Bags</span>';
        html += '<span class="spec-pill"><i class="fas fa-key"></i> Self-Drive: ' + $('<div/>').text(selfdrive).html() + '</span>';
        html += '</div>';

        if (description) {
            html += '<div class="mb-3">';
            html += '<h6 class="font-weight-bold text-muted small text-uppercase mb-1">Description</h6>';
            html += '<p class="text-secondary small mb-0" style="line-height: 1.6;">' + $('<div/>').text(description).html().replace(/\n/g, '<br/>') + '</p>';
            html += '</div>';
        }

        // Features Section
        html += '<div class="mt-3 pt-3 border-top">';
        html += '<h6 class="font-weight-bold text-dark mb-2"><i class="fas fa-star text-warning mr-1"></i> Included Features (' + features.length + ')</h6>';
        
        if (features && features.length > 0) {
            html += '<div class="d-flex flex-wrap">';
            for (var i = 0; i < features.length; i++) {
                var f = features[i];
                var iconClass = f.Icon && f.Icon.indexOf('fa-') > -1 ? f.Icon : 'fas fa-check';
                html += '<div class="feature-badge-pill" title="' + $('<div/>').text(f.Description || '').html() + '">';
                html += '<i class="' + iconClass + '"></i> ';
                html += '<span>' + $('<div/>').text(f.Title).html() + '</span>';
                html += '</div>';
            }
            html += '</div>';
        } else {
            html += '<p class="text-muted small font-italic mb-0">No features assigned to this cab.</p>';
        }

        html += '</div>'; // End Features
        html += '</div>'; // End Column
        html += '</div>'; // End Row

        $('#modal-getbyid .lbl-module').text('Cab');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }

    // Maintain backwards compatibility
    function showReviewDetails(btn) {
        showCabDetails(btn);
    }
</script>

<script src="~/js/managemodule.js"></script>
<script src="~/js/managemodule.js"></script>