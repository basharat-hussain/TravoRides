@using TravoRides.Application.DTOs.SelfDrive
@using TravoRides.Domain.Enums
@model CreateSelfDriveRequest
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>SelfDrive Add</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/SelfDrive/Index">SelfDrive</a></li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="offset-md-2 col-md-8">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Add SelfDrive</h3>

                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <form id="addform" enctype="multipart/form-data" asp-controller="SelfDrive" asp-action="Create" asp-antiforgery="false" data-ajax="true" data-ajax-method="post" data-ajax-success="onSuccess" data-ajax-failure="onFailure" data-ajax-begin="onBegin">
                       
                        <div class="row">
                          
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CategoryId" class="form-label">Category</label>

                                    <select asp-for="CategoryId" class="form-control">
                                        <option value="">-- Select Category --</option>

                                        @foreach (var Category in ViewBag.Categories)
                                        {
                                            <option value="@Category.Id">
                                                @Category.Name
                                            </option>
                                        }
                                    </select>

                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CabId" class="form-label">Cab</label>
                                  @*   <select asp-for="CabId" class="form-control">
                                        <option value="">-- Select Cab --</option>

                                        @foreach (var cab in ViewBag.Cabs)
                                        {
                                            <option value="@cab.Id">
                                                @cab.Name
                                            </option>
                                        }
                                    </select> *@
                                    <select asp-for="CabId" id="CabId" name="CabId" class="form-control">
                                        <option value="">-- Select Cab --</option>
                                    </select>
                                    <span asp-validation-for="CabId" class="text-danger"></span>
                                </div>
                            </div>
                                
                             </div>
                              <div class="row">
                            <div class="col-md-6">

                                <div class="form-group">
                                    <label>Price</label>
                                    <input asp-for="PricePerDay" class="form-control" />
                                    <span asp-validation-for="PricePerDay" class="text-danger"></span>
                                </div>
                            </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Discount</label>
                                        <input asp-for="Discount" class="form-control" rows="4" />
                                        <span asp-validation-for="Discount" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                     

                     
                      

                        <div class="form-group">
                            <button type="submit" class="btn btn-success save-btn"><i class="fas fa-save"></i> Save</button>
                            <button type="reset" class="btn btn-danger"><i class="fas fa-recycle"></i> Reset</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

    </div>

</section>

<partial name="_ValidationScriptsPartial" />

<script>
    var module = "SelfDrive";
</script>

<script src="~/js/managemodule.js"></script>
<script src="~/js/CabByCategory.js"></script>