@using TravoRides.Application.DTOs.SelfDrive
@using TravoRides.Domain.Enums
@model UpdateSelfDriveRequest

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>SelfDrive Edit</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/SelfDrive/Index">SelfDrive</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->

<section class="content">
    <div class="row">
        @if (Model is null)
        {
            <div class="offset-md-2 col-md-8 mt-4">
                <div class="alert alert-warning text-center"><i class="fas fa-frown fa-4x"></i><h3 class="mt-2">Sorry! Category Details not found</h3></div>
            </div>
        }
        else
        {

            <div class="offset-md-2 col-md-8">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Edit SelfDrive</h3>

                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <form id="editform" enctype="multipart/form-data" asp-controller="SelfDrive" asp-action="Edit" asp-antiforgery="false" data-ajax="true" data-ajax-method="post" data-ajax-success="onSuccess" data-ajax-failure="onFailure" data-ajax-begin="onBegin">
                            <input type="hidden" asp-for="Id" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CategoryId" class="form-label">Category</label>
                                        <select id="CategoryId"
                                                class="form-control"
                                                asp-for="@Model.CategoryId">

                                            <option value="">-- Select Category --</option>

                                            @foreach (var category in ViewBag.Categories)
                                            {
                                                <option value="@category.Id">
                                                    @category.Name
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="CabId" class="form-label">Cab</label>

                                        @* <select id="CabId"
                                                class="form-control"
                                                asp-for="@Model.CabId">

                                            <option value="">-- Select Cab --</option>

                                            @if (Model.CabId != Guid.Empty)
                                            {
                                                <option value="@Model.CabId">
                                                    @Model.CabName
                                                </option>
                                            }

                                        </select> *@
                                        <select id="CabId"
                                                asp-for="@Model.CabId"
                                                class="form-control"
                                                data-selected-cab="@Model.CabId">

                                            <option value="">-- Select Cab --</option>

                                        </select>
                                        <span asp-validation-for="CabId" class="text-danger"></span>
                                    </div>
                                </div>
 
                            <div class="row">
                               

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Discount</label>
                                        <input asp-for="Discount" class="form-control" rows="4" />
                                        <span asp-validation-for="Discount" class="text-danger"></span>
                                    </div>
                                </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Price</label>
                                            <input asp-for="PricePerDay" class="form-control" />
                                            <span asp-validation-for="PricePerDay" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <div class="row">
                            <div class="form-group">
                                <button type="submit" class="btn btn-success save-btn"><i class="fas fa-save"></i> Save</button>
                                <button type="reset" class="btn btn-danger"><i class="fas fa-recycle"></i> Reset</button>
                            </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        }



    </div>

</section>


  
<partial name="_ValidationScriptsPartial" />

  


<script>
    var module = "SelfDrive";
    var operation = "Edit";
</script>

<script src="~/js/managemodule.js"></script>


