
@model ApiResponse<PagedResponse<CabDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>SelfDrives</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">SelfDrives</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">SelfDrives</h3>

            <div class="card-tools">
                <a asp-controller="SelfDrive" asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> &nbsp; Add SelfDrive
                </a>

            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_SelfDrivesPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "SelfDrive";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var category = $btn.data('category')
        var name = $btn.data('name') || '';
        var price = $btn.data('price') || '';
       var discount = $btn.data('discount');

        var html = '<div class="row">';
       
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Category:</strong> ' + $('<div/>').text(category).html() + '</p>';

        html += '<p><strong>Cab:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Price:</strong> ' + $('<div/>').text(price).html() + '</p>';
        html += '<p><strong>Discount:</strong> ' + $('<div/>').text(discount).html() + '</p>';
       

        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('SelfDrive');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>