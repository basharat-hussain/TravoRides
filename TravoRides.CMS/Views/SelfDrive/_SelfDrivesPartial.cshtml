@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Cabs
@model PagedResponse<CabDTO>

@if (Model != null && Model.Items.Any())
{
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 10%" class="text-center">Thumbnail</th>
            <th style="width: 18%">Category</th>
            <th style="width: 22%">Cab Name</th>
            <th style="width: 14%">Price / Day</th>
            <th style="width: 13%">Discount (₹)</th>
            <th style="width: 10%" class="text-center">Actions</th>
            <th style="width: 8%" class="text-center">View</th>
        </tr>
    </thead>

    <tbody>
        @{ int count = ((Model.PageNumber - 1) * Model.PageSize) + 1; }
        @foreach (var Cab in Model.Items)
        {
            var price = Cab.SelfDrive?.PricePerDay ?? Cab.PricePerDay;
            var discount = Cab.SelfDrive?.Discount ?? Cab.Discount;
            <tr>
                <td>
                    @(count++)
                    <input type="hidden" class="hdn-id" value="@Cab.Id" />
                </td>

                <td class="text-center">
                    @if (!string.IsNullOrWhiteSpace(Cab.ImageUrl))
                    {
                        <img src="@Cab.ImageUrl" alt="@Cab.Name" class="rounded border shadow-sm" style="width: 54px; height: 38px; object-fit: cover;" onerror="this.onerror=null;this.src='/dist/img/200x80.png';" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-inline-flex align-items-center justify-content-center text-muted" style="width: 54px; height: 38px;">
                            <i class="fas fa-car"></i>
                        </div>
                    }
                </td>

                <td>
                    <span class="badge badge-light border text-primary px-2 py-1 font-weight-bold">
                        @(Cab.Category?.Name ?? "Uncategorized")
                    </span>
                </td>

                <td class="name font-weight-bold text-dark">
                    @Cab.Name
                    <br />
                    <small class="text-muted">
                        <i class="fas fa-gas-pump mr-1"></i>@Cab.Fuel &bull; <i class="fas fa-cogs mr-1"></i>@Cab.Transmission
                    </small>
                </td>

                <td class="font-weight-bold text-success">
                    ₹@price.ToString("N0")
                </td>
                <td>
                    @(discount > 0 ? "₹" + discount.ToString("N0") : "₹0")
                </td>

                <td class="project-actions text-center">
                    <a asp-controller="SelfDrive" asp-action="Edit" asp-route-id="@Cab.Id" class="btn btn-warning btn-sm" data-toggle="tooltip" data-placement="top" title="Edit">
                        <i class="fas fa-pencil-alt"></i>
                    </a>
                    <a class="btn btn-danger btn-sm btn-delete" href="#" data-toggle="modal" data-target="#modal-delete" title="Delete">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-outline-info btn-sm btn-view" onclick="showSelfDriveDetails(this)"
                            data-id="@Cab.Id"
                            data-category="@(Cab.Category?.Name ?? "Uncategorized")"
                            data-name="@Cab.Name"
                            data-price="₹@price.ToString("N0")"
                            data-discount="@(discount > 0 ? "₹" + discount.ToString("N0") : "None")"
                            data-fuel="@Cab.Fuel"
                            data-transmission="@Cab.Transmission"
                            data-seating="@Cab.SeatingCapacity"
                            data-luggage="@Cab.LuggageCapacity"
                            data-description="@Cab.Description"
                            data-imageurl="@Cab.ImageUrl">
                        <i class="fas fa-eye mr-1"></i> View
                    </button>
                </td>
            </tr>
        }
    </tbody>
}
else
{
    <tbody>
        <tr>
            <td colspan="8" class="text-center py-4 text-muted">Sorry! No SelfDrives found</td>
        </tr>
    </tbody>
}
