@using TravoRides.Application.Common.Responses
@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Enquirer
@model ApiResponse<PagedResponse<EnquiryDTO>>
@* Breadcrumb *@
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Enquiries</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Enquiry</li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* Content *@
<section class="content">

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Enquiry</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-responsive dataTable" id="data-grid">
                @await Html.PartialAsync("_EnquiriesPartial", Model.Data)
            </table>
        </div>
        <div class="card-footer clearfix">
            @await Html.PartialAsync("~/Views/Shared/_PaginationPartial.cshtml", Model.Data)
        </div>
    </div>

</section>

<partial name="_ManageModalsPartial" />
<partial name="_ValidationScriptsPartial" />

<script>
    var module = "Enquiry";
</script>

<script>
    function showReviewDetails(btn) {
        var $btn = $(btn);
        var id = $btn.data('id');
        var name = $btn.data('name') || '';
        var email = $btn.data('email') || '';
        var phone = $btn.data('phone') || '';
        var subject = $btn.data('subject') || '';
        var message = $btn.data('message') || '';

        var html = '<div class="row">';
       
        html += '</div>';
        html += '<div class="col-md-8">';
        html += '<p><strong>Name:</strong> ' + $('<div/>').text(name).html() + '</p>';
        html += '<p><strong>Email:</strong> ' + $('<div/>').text(email).html() + '</p>';
        html += '<p><strong>Phone:</strong> ' + $('<div/>').text(phone).html() + '</p>';
        html += '<p><strong>Subject:</strong> ' + $('<div/>').text(subject).html() + '</p>';
        html += '<p><strong>Message:</strong><br />' + $('<div/>').text(message).html().replace(/\n/g, '<br/>') + '</p>';
        html += '</div>';
        html += '</div>';

        $('#modal-getbyid .lbl-module').text('Enquiry');
        $('#modal-getbyid #modal-body').html(html);
        $('#modal-getbyid').modal('show');
    }
    </script>
<script src="~/js/managemodule.js"></script>