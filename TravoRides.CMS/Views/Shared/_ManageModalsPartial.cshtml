<div class="modal fade" id="modal-delete">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-trash"></i> Delete <span class="lbl-module"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <span class="lbl"></span> <span class="lbl-module"></span>?</p>
            </div>
            <div class="modal-footer">
                <a data-ajax="true" data-ajax-url="" data-ajax-update="#data-grid" data-ajax-begin="onDeleteBegin" data-ajax-success="onDeleteSuccess" data-ajax-failure="onDeleteFailure" class="btn btn-danger delete-btn-confirm"><i class="fas fa-check"></i> &nbsp;Yes</a>
                <button type="button" class="btn btn-primary" data-dismiss="modal"><i class="fas fa-times"></i> No</button>
            </div>
        </div>
    </div>
</div>

