@using TravoRides.Application.DTOs.Common
@using TravoRides.Application.DTOs.Subscription
@model PagedResponse<SubscriptionDTO>

@if (Model.Items.Count() > 0)
{
    <thead>
        <tr>
            <th style="width: 20%">
                S.No
            </th>

            <th style="width: 30%">
                Email
            </th>
            
           
        </tr>
    </thead>

    <tbody>
        @{ int count = 1;}
        @foreach (var enquiry in Model.Items)
        {
        <tr>
            <td>
                @(count++)
                <input type="hidden" class="hdn-id" value="@enquiry.Id" />
            </td>
            
            <td>@enquiry.Email</td>
               
        </tr>
        }

    </tbody>
}
else
{
    <tr>
        <td>Sorry! No Subscription found</td>
    </tr>
}